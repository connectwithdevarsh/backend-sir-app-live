# Multi-Provider AI Configuration for AIPE LAB Backend

# 1. Groq API Key & Model (Ultra-Fast LPU Inference)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 2. Google Gemini API Key & Model
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 3. NVIDIA Nemotron API Key & Model (OpenAI-compatible NIM Inference)
# Get key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Concurrency & Queue Configuration
MAX_AI_CONCURRENCY=5
AI_QUEUE_TIMEOUT=90
CACHE_TTL_SECONDS=300

HOST=0.0.0.0
PORT=8000
